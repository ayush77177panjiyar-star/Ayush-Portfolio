{
  "entities": {
    "Login": {
      "title": "Login",
      "description": "Records of user logins for administrative tracking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The unique ID of the user." },
        "email": { "type": "string", "description": "The email of the user (if available)." },
        "phoneNumber": { "type": "string", "description": "The phone number of the user (if available)." },
        "method": { "type": "string", "description": "Sign-in method (google, phone)." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the login occurred." },
        "userAgent": { "type": "string", "description": "Browser user agent." }
      },
      "required": ["userId", "method", "timestamp"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio project details.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Project title." },
        "description": { "type": "string", "description": "Long form description." },
        "shortDescription": { "type": "string", "description": "Brief summary for card view." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Tech stack tags." },
        "github": { "type": "string", "description": "GitHub URL." },
        "demo": { "type": "string", "description": "Live demo URL." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["title", "description", "tags"]
    }
  },
  "firestore": {
    "logins": {
      "schema": "Login",
      "description": "Collection of all login events."
    },
    "projects": {
      "schema": "Project",
      "description": "Collection of portfolio projects."
    }
  }
}
