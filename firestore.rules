rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == 'ayush77177panjiyar@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Entities ---
    
    // Login Entity Validation
    function isValidLogin(data) {
      return data.userId is string && data.userId.size() <= 128
        && (data.email == null || (data.email is string && data.email.size() <= 256))
        && (data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && data.method in ['google', 'phone']
        && data.timestamp == request.time
        && (data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 1024))
        && data.keys().hasAll(['userId', 'method', 'timestamp'])
        && data.keys().size() >= 3 && data.keys().size() <= 6;
    }

    // Project Entity Validation
    function isValidProject(data) {
      return data.title is string && data.title.size() <= 128
        && data.description is string && data.description.size() <= 5000
        && (data.shortDescription == null || (data.shortDescription is string && data.shortDescription.size() <= 500))
        && data.tags is list && data.tags.size() <= 20
        && (data.github == null || (data.github is string && data.github.size() <= 512))
        && (data.demo == null || (data.demo is string && data.demo.size() <= 512))
        && (data.updatedAt == null || data.updatedAt == request.time)
        && data.keys().hasAll(['title', 'description', 'tags'])
        && data.keys().size() >= 3 && data.keys().size() <= 7;
    }

    // 1. Logins Collection
    match /logins/{loginId} {
      // Only admins can see the login history
      allow list: if isAdmin();
      
      // Any signed-in user can record their login
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && isValidLogin(incoming());

      // Logins are immutable once created
      allow update, delete: if false;
    }

    // 2. Projects Collection
    match /projects/{projectId} {
      // Anyone can read projects
      allow read, list: if true;

      // Only admins can modify projects
      allow create, update: if isAdmin() && isValidProject(incoming());
      allow delete: if isAdmin();
    }
  }
}
