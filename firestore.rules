rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == 'ayush77177panjiyar@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Entities ---
    
    // Login Entity Validation
    function isValidLogin(data) {
      return data.userId is string && data.userId.size() <= 128
        && (data.email == null || (data.email is string && data.email.size() <= 256))
        && (data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && data.method in ['google', 'phone']
        && data.timestamp == request.time
        && (data.userAgent == null || (data.userAgent is string && data.userAgent.size() <= 1024))
        && data.keys().hasAll(['userId', 'method', 'timestamp'])
        && data.keys().size() >= 3 && data.keys().size() <= 6;
    }

    // 1. Logins Collection
    match /logins/{loginId} {
      // Only admins can see the login history
      allow list: if isAdmin();
      
      // Any signed-in user can record their login
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && isValidLogin(incoming());

      // Logins are immutable once created
      allow update, delete: if false;
    }
  }
}
